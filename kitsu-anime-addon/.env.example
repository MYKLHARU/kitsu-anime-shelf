# Kitsu Anime Shelf configuration. Copy to .env for local use (never commit .env).
# The server reads these from the environment; it does not load .env files itself.

HOST=127.0.0.1
PORT=47861

# Load all offered rows in the background shortly after start-up (default on).
# WARM_CATALOGS=true

# Optional title logos and HD backgrounds (see README).
# TMDB_API_KEY=
# PUBLIC_URL=http://127.0.0.1:47861

# ---- 2.0 personal shelves (off unless ACCOUNTS_ENABLED=true) ----
# ACCOUNTS_ENABLED=true
# PUBLIC_URL must be the exact origin: https in production, http://localhost or 127.0.0.1 for development.
# PUBLIC_URL=http://127.0.0.1:47861
# DATABASE_URL=postgres://shelf_app:password@localhost:5432/shelf?sslmode=prefer
# Generate with: openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY=
# Number of reverse proxies in front of the service (Northflank/Render: 1).
# TRUST_PROXY_HOPS=0
# REGISTRATION_OPEN=true
# RUN_MIGRATIONS_ON_START=false
# DATABASE_POOL_MAX=10

# Optional AniList sync. Redirect URL: <PUBLIC_URL>/api/v2/anilist/callback
# ANILIST_CLIENT_ID=
# ANILIST_CLIENT_SECRET=

# Tests: a disposable database for integration tests.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/shelf_test?sslmode=disable
